# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build output — `prepare` rebuilds it on install
dist/
*.tsbuildinfo

# Test and coverage artifacts
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets and local environment
.env
.env.*
!.env.example

# morse local state
#
# Role definitions under .morse/roles are meant to be committed — that is how a
# project shares a cast with everyone who clones it. Only the message store is
# machine-local, so ignore the database rather than the whole directory.
.morse/*.db
.morse/*.db-wal
.morse/*.db-shm

# Scratch space for agent sessions
tmp/
scratch/

# Editor and tooling
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
